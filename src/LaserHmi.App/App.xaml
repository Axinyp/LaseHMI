<Application x:Class="LaserHmi.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LaserHmi.App.Converters"
             xmlns:views="clr-namespace:LaserHmi.App.Views"
             xmlns:vm="clr-namespace:LaserHmi.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
                <ResourceDictionary Source="Themes/Inputs.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  ==================== 值转换器 ====================  -->
            <conv:ConnectionTextConverter x:Key="ConnectionText" />
            <conv:ConnectionBrushConverter x:Key="ConnectionBrush" />
            <conv:MachineStateTextConverter x:Key="MachineStateText" />
            <conv:MachineStateBrushConverter x:Key="MachineStateBrush" />
            <conv:LogLevelBrushConverter x:Key="LogLevelBrush" />
            <conv:LogLevelBadgeBrushConverter x:Key="LogLevelBadgeBrush" />
            <conv:LogLevelTextConverter x:Key="LogLevelText" />
            <conv:MachineStateHintConverter x:Key="MachineStateHint" />
            <conv:AlarmSeverityTextConverter x:Key="AlarmSeverityText" />
            <conv:AlarmSeverityBrushConverter x:Key="AlarmSeverityBrush" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:BoolToTextConverter x:Key="BoolToText" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!--  ==================== ViewModel → View 映射（页面导航） ====================  -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkbenchViewModel}">
                <views:WorkbenchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ParametersViewModel}">
                <views:ParametersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DeviceControlViewModel}">
                <views:DeviceControlView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AlarmLogViewModel}">
                <views:AlarmLogView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
