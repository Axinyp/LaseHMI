<Window x:Class="LaserHmi.App.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认操作"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource FontMain}"
        TextOptions.TextFormattingMode="Display">

    <Border Margin="18"
            Background="{StaticResource BrushBgCard}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26"
                              Direction="270"
                              Opacity="0.55"
                              ShadowDepth="4"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="22,20,22,20" MouseLeftButtonDown="Root_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  标题行：图标 + 标题  -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border x:Name="IconBadge"
                        Width="38"
                        Height="38"
                        Background="{StaticResource BrushAccentSoft}"
                        CornerRadius="9">
                    <Path x:Name="IconPath"
                          Width="24"
                          Height="24"
                          Data="{StaticResource IconInfo}"
                          Stretch="None"
                          Stroke="{StaticResource BrushAccent}"
                          StrokeThickness="1.7" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="确认操作" />
            </StackPanel>

            <!--  正文  -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       Margin="0,16,0,0"
                       FontSize="12.5"
                       Foreground="{StaticResource BrushTextSecondary}"
                       LineHeight="21"
                       TextWrapping="Wrap" />

            <!--  按钮区  -->
            <StackPanel Grid.Row="2"
                        Margin="0,22,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button MinWidth="92"
                        AutomationProperties.AutomationId="DialogCancelButton"
                        Content="取消"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="ConfirmButton"
                        MinWidth="110"
                        Margin="10,0,0,0"
                        AutomationProperties.AutomationId="DialogConfirmButton"
                        Content="确认"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
