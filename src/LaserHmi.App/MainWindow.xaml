<Window x:Class="LaserHmi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaserHMI · 激光打标上位机原型"
        Width="1420"
        Height="880"
        MinWidth="1200"
        MinHeight="740"
        Background="{StaticResource BrushBgBase}"
        FontFamily="{StaticResource FontMain}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  左侧导航列表  -->
        <Style x:Key="NavListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="7"
                                Margin="10,2"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3"
                                        CornerRadius="1.5"
                                        HorizontalAlignment="Left"
                                        Margin="2,9,0,9"
                                        Background="Transparent" />
                                <Grid Height="42" Margin="14,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="Icon"
                                          Grid.Column="0"
                                          Width="24"
                                          Height="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                          Stretch="None"
                                          Stroke="{StaticResource BrushTextMuted}"
                                          StrokeThickness="1.6" />
                                    <TextBlock x:Name="Label"
                                               Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Text="{Binding Title}" />
                                    <Border x:Name="Badge"
                                            Grid.Column="2"
                                            MinWidth="18"
                                            Height="18"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BrushDanger}"
                                            CornerRadius="9">
                                        <TextBlock Margin="5,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="10.5"
                                                   Foreground="White"
                                                   Text="{Binding BadgeCount}" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushBgCard}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushAccentSoft}" />
                                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource BrushAccent}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource BrushAccent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding BadgeCount}" Value="0">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  顶栏状态徽章  -->
        <Style x:Key="TopBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushBgCardAlt}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!--  ==================== 顶栏 ====================  -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Logo  -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="34"
                            Height="34"
                            Background="{StaticResource BrushAccentSoft}"
                            CornerRadius="8">
                        <Path Width="24"
                              Height="24"
                              Data="{StaticResource IconZap}"
                              Stretch="None"
                              Stroke="{StaticResource BrushAccent}"
                              StrokeThickness="1.7" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="LaserHMI" />
                        <TextBlock Style="{StaticResource CaptionText}" Text="激光打标上位机" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        Margin="18,14"
                        Background="{StaticResource BrushBorderSoft}" />

                <!--  设备与运行状态  -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="LK-60 光纤激光打标机" />
                    <Border Style="{StaticResource TopBadge}" ToolTip="上位机与设备的通讯状态">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Status.Connection, Converter={StaticResource ConnectionBrush}}" />
                            <TextBlock Margin="6,0,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Text="{Binding Status.Connection, Converter={StaticResource ConnectionText}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TopBadge}" ToolTip="设备主状态">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Status.State, Converter={StaticResource MachineStateBrush}}" />
                            <TextBlock Margin="6,0,0,0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Status.State, Converter={StaticResource MachineStateBrush}}"
                                       Text="{Binding Status.State, Converter={StaticResource MachineStateText}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  系统时钟  -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal">
                    <Path Width="24"
                          Height="24"
                          Data="{StaticResource IconClock}"
                          Stretch="None"
                          Stroke="{StaticResource BrushTextMuted}"
                          StrokeThickness="1.5" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="12.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding ClockText}" />
                </StackPanel>

                <!--  报警铃  -->
                <Button Grid.Column="5"
                        Margin="14,0,0,0"
                        Command="{Binding GoToAlarmsCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="查看报警与日志">
                    <Grid>
                        <Path Width="24"
                              Height="24"
                              Data="{StaticResource IconAlarm}"
                              Stretch="None"
                              Stroke="{StaticResource BrushTextSecondary}"
                              StrokeThickness="1.5" />
                        <Border MinWidth="16"
                                Height="16"
                                Margin="10,-5,-5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource BrushDanger}"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Margin="4,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="{Binding ActiveAlarmCount}" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!--  ==================== 主体：导航 + 页面 ====================  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BrushBgPanel}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="20,18,0,8"
                               Style="{StaticResource CaptionText}"
                               Text="功能导航" />
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="20,8,0,14"
                               Style="{StaticResource CaptionText}"
                               Text="v1.0 · Mock 模拟模式"
                               TextWrapping="Wrap" />
                    <ListBox ItemContainerStyle="{StaticResource NavItem}"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding SelectedPage}"
                             Style="{StaticResource NavListBox}" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding SelectedPage}" />
        </Grid>

        <!--  ==================== 底部状态条 ====================  -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource CaptionText}"
                           Text="LK-60 光纤激光打标机 · 固件 v3.2.1 · SN LK60A-20240317-042" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="激光头坐标" />
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding Status.Motion.X, StringFormat=X {0:F2}}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding Status.Motion.Y, StringFormat=Y {0:F2}}" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="11.5"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Text="{Binding Status.Motion.Z, StringFormat=Z {0:F2}}" />
                    <TextBlock Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="mm" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
