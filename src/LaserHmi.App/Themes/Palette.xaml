<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--  ==================== 深色工业风色板 ====================  -->

    <!--  背景层级：基底层 → 面板层 → 卡片层  -->
    <SolidColorBrush x:Key="BrushBgBase" Color="#0C111E" />
    <SolidColorBrush x:Key="BrushBgPanel" Color="#111927" />
    <SolidColorBrush x:Key="BrushBgCard" Color="#151F33" />
    <SolidColorBrush x:Key="BrushBgCardAlt" Color="#1A2740" />
    <SolidColorBrush x:Key="BrushBgInput" Color="#0E1626" />
    <SolidColorBrush x:Key="BrushBlack" Color="#05080F" />

    <!--  描边  -->
    <SolidColorBrush x:Key="BrushBorderSoft" Color="#1D2A42" />
    <SolidColorBrush x:Key="BrushBorder" Color="#283854" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#35496B" />

    <!--  文本  -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#E8F0FA" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#9AAEC8" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#5F738E" />
    <SolidColorBrush x:Key="BrushTextOnAccent" Color="#06131C" />

    <!--  语义色  -->
    <SolidColorBrush x:Key="BrushAccent" Color="#38C3FF" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="#63D3FF" />
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#1E9FD8" />
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#14344A" />
    <SolidColorBrush x:Key="BrushSuccess" Color="#46D08A" />
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#12321F" />
    <SolidColorBrush x:Key="BrushWarning" Color="#FFB454" />
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#3A2A12" />
    <SolidColorBrush x:Key="BrushDanger" Color="#FF5D5D" />
    <SolidColorBrush x:Key="BrushDangerHover" Color="#FF7B7B" />
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#3A161C" />
    <SolidColorBrush x:Key="BrushLaser" Color="#FF4D6A" />
    <SolidColorBrush x:Key="BrushLaserSoft" Color="#3A1220" />
    <SolidColorBrush x:Key="BrushIdle" Color="#61748F" />

    <!--  加工预览专用  -->
    <SolidColorBrush x:Key="BrushPreviewBg" Color="#0A0F1B" />
    <SolidColorBrush x:Key="BrushPreviewGrid" Color="#16203432" />
    <SolidColorBrush x:Key="BrushPreviewGridStrong" Color="#22304C" />
    <SolidColorBrush x:Key="BrushPathRaw" Color="#33455F" />
    <SolidColorBrush x:Key="BrushPathMarked" Color="#3EC6FF" />

    <!--  字体  -->
    <FontFamily x:Key="FontMain">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Consolas, Microsoft YaHei UI</FontFamily>

    <!--  动效 / 尺寸  -->
    <sys:Double x:Key="DoubleRadius">6</sys:Double>
    <sys:Double x:Key="DoubleRadiusLarge">10</sys:Double>
    <CornerRadius x:Key="RadiusCard">8</CornerRadius>
    <Duration x:Key="DurationFast">0:0:0.12</Duration>

</ResourceDictionary>
