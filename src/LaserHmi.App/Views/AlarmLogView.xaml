<UserControl x:Class="LaserHmi.App.Views.AlarmLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:LaserHmi.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AlarmLogViewModel}"
             d:DesignHeight="760"
             d:DesignWidth="1100"
             mc:Ignorable="d">

    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  标题行 + 活动报警统计  -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleText}" Text="报警与日志" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionText}"
                           Text="跟踪报警确认状态与运行日志，支持级别过滤与关键字检索" />
            </StackPanel>
            <Border Padding="13,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushBgCard}"
                    BorderBrush="{StaticResource BrushBorderSoft}"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14"
                          Height="14"
                          VerticalAlignment="Center"
                          Data="{StaticResource IconAlarm}"
                          Stretch="Uniform"
                          StrokeThickness="1.7">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Stroke" Value="{StaticResource BrushDanger}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveAlarmCount}" Value="0">
                                        <Setter Property="Stroke" Value="{StaticResource BrushTextMuted}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <TextBlock Margin="8,0,0,0"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Text="{Binding ActiveAlarmCount, StringFormat=活动报警 {0} 条}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  活动报警卡  -->
        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="活动报警" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="确认后从活动列表移除；设备自行恢复的报警将标注「已恢复」" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <CheckBox VerticalAlignment="Center"
                                  Content="仅显示未确认"
                                  IsChecked="{Binding OnlyPending}" />
                        <Button Margin="14,0,0,0"
                                Command="{Binding AcknowledgeAllCommand}"
                                Content="全部确认"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Grid>

                <!--  表头  -->
                <Border Margin="0,12,0,0"
                        Padding="0,0,0,7"
                        BorderBrush="{StaticResource BrushBorderSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="74" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource LabelText}" Text="时间" />
                        <TextBlock Grid.Column="1" Style="{StaticResource LabelText}" Text="级别" />
                        <TextBlock Grid.Column="2" Style="{StaticResource LabelText}" Text="代码" />
                        <TextBlock Grid.Column="3" Style="{StaticResource LabelText}" Text="来源" />
                        <TextBlock Grid.Column="4" Style="{StaticResource LabelText}" Text="描述" />
                        <TextBlock Grid.Column="5" Style="{StaticResource LabelText}" Text="状态" />
                        <TextBlock Grid.Column="6"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource LabelText}"
                                   Text="操作" />
                    </Grid>
                </Border>

                <!--  报警列表  -->
                <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AlarmListView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,9"
                                        BorderBrush="{StaticResource BrushBorderSoft}"
                                        BorderThickness="0,0,0,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                                    <Setter Property="Background" Value="#14FF5D5D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="74" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushTextSecondary}"
                                                   Text="{Binding TimeText}" />
                                        <Border Grid.Column="1"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                BorderBrush="{Binding Severity, Converter={StaticResource AlarmSeverityBrush}}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <TextBlock FontSize="10.5"
                                                       Foreground="{Binding Severity, Converter={StaticResource AlarmSeverityBrush}}"
                                                       Text="{Binding Severity, Converter={StaticResource AlarmSeverityText}}" />
                                        </Border>
                                        <TextBlock Grid.Column="2"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   Text="{Binding Code}" />
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   Text="{Binding Source}" />
                                        <TextBlock Grid.Column="4"
                                                   Margin="0,0,14,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding Message}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Message}" />
                                        <TextBlock Grid.Column="5"
                                                   VerticalAlignment="Center"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="待处理" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecovered}" Value="True">
                                                            <Setter Property="Text" Value="已恢复" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                            <Setter Property="Text" Value="已确认" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="6"
                                                Padding="12,3"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="确认"
                                                FontSize="11.5"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVis}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  空态  -->
                <TextBlock Margin="0,18,0,10"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           Text="当前没有活动报警"
                           Visibility="{Binding AlarmListView.IsEmpty, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <!--  运行日志卡  -->
        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitleText}" Text="运行日志" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ComboBox Width="140"
                                  ItemsSource="{Binding LevelOptions}"
                                  SelectedItem="{Binding SelectedLevelOption}" />
                        <Grid Margin="10,0,0,0">
                            <TextBox Width="200"
                                     Padding="11,7"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       IsHitTestVisible="False"
                                       Text="搜索消息或来源…">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <CheckBox Margin="14,0,0,0"
                                  VerticalAlignment="Center"
                                  Content="自动滚动"
                                  IsChecked="{Binding AutoScroll}" />
                        <Button Margin="10,0,0,0"
                                Command="{Binding ClearLogsCommand}"
                                Content="清空"
                                Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer x:Name="LogScroll"
                              Grid.Row="1"
                              Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LogListView}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2.5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="{StaticResource FontMono}"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               Text="{Binding TimeText}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11.5"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelBrush}}"
                                               Text="{Binding Level, Converter={StaticResource LogLevelText}}" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="11.5"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Text="{Binding Source}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="0,0,12,0"
                                               FontSize="12"
                                               Text="{Binding Message}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Message}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
